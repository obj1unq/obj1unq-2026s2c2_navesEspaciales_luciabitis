import naves2.*

describe "Nave de carga" {
	const naveVacia = new NaveDeCarga(carga = 0, velocidad = 50000)
	const naveLlena = new NaveDeCarga(carga = 500000, velocidad = 290000)
	
	test "sobrecargada" {
		assert.that(naveLlena.sobrecargada())
	}
	
	test "no sobrecargada" {
		assert.notThat(naveVacia.sobrecargada())
	}
	
	test "excedida de velocidad" {
		assert.that(naveLlena.excedidaDeVelocidad())
	}
	
	test "no excedida de velocidad" {
		assert.notThat(naveVacia.excedidaDeVelocidad())
	}
	
	test "recibir amenaza" {
		naveLlena.recibirAmenaza()
		assert.equals(0, naveLlena.carga())
	}
	
	test "acercamiento a control de nave en falta" {
		naveLlena.acercamientoDeControl()
		assert.equals(0, naveLlena.carga())
	}
	
	test "acercamiento a control de nave en regla" {
		naveLlena.carga(100)
		naveLlena.acercamientoDeControl()
		assert.equals(100, naveLlena.carga())
	}
}

describe "Nave de pasajeros" {
	const naveSinPasajeros = new NaveDePasajeros(
		cantidadDePasajeros = 0,
		velocidad = 50000
	)
	const naveConPasajeros = new NaveDePasajeros(
		cantidadDePasajeros = 296,
		velocidad = 290000
	)
	
	test "velocidad maxima sin pasajeros" {
		assert.equals(75000, naveSinPasajeros.velocidadMaximaPermitida())
	}
	
	test "velocidad maxima con pasajeros" {
		assert.equals(1000 - 200, naveConPasajeros.velocidadMaximaPermitida())
	}
	
	test "esta en peligro" {
		assert.that(naveConPasajeros.estaEnPeligro())
	}
	
	test "no esta en peligro" {
		assert.notThat(naveSinPasajeros.estaEnPeligro())
	}
	
	test "recibir amenaza" {
		naveSinPasajeros.recibirAmenaza()
		assert.that(naveSinPasajeros.alarma())
	}
}

describe "Nave de combate" {
	const naveEnReposo = new NaveDeCombate(modo = reposo, velocidad = 5000)
	const naveEnAtaque = new NaveDeCombate(modo = ataque, velocidad = 5000)
	
	test "no esta invisible en reposo" {
		assert.notThat(naveEnReposo.estaInvisible())
	}
	
	test "esta invisible en ataque" {
		assert.that(naveEnAtaque.estaInvisible())
	}
	
	test "no esta invisible en ataque" {
		naveEnAtaque.velocidad(20000)
		assert.notThat(naveEnAtaque.estaInvisible())
	}
	
	test "recibir amenaza en reposo" {
		naveEnReposo.recibirAmenaza()
		assert.equals("¡RETIRADA!", naveEnReposo.ultimoMensaje())
	}
	
	test "recibir amenaza en ataque" {
		naveEnAtaque.recibirAmenaza()
		assert.equals("Enemigo encontrado", naveEnAtaque.ultimoMensaje())
	}
}

describe "Naves Espaciales" {
	const naveDeCargaVacia = new NaveDeCarga(velocidad = 0, carga = 0)
	const naveConPasajeros = new NaveDePasajeros(
		cantidadDePasajeros = 296,
		velocidad = 290000
	)
	const naveDeResiduosToxis = new NaveDeResiduosRadioactivos(
		carga = 5000,
		velocidad = 10000
	)
	const naveDeResiduosViajera = new NaveDeResiduosRadioactivos(
		carga = 5000,
		velocidad = 0,
		selladaAlVacio = false
	)
	const naveEnReposo = new NaveDeCombate(modo = reposo, velocidad = 0)
	const naveEnAtaque = new NaveDeCombate(modo = ataque, velocidad = 0)
	const naveConPasajerosNoVeloz = new NaveDePasajeros(
		cantidadDePasajeros = 296,
		velocidad = 0
	)
	
	test "Se propulsa una nave de pasajeros" {
		naveConPasajeros.propulsar()
		assert.equals(300000, naveConPasajeros.velocidad())
	}
	
	test "Se propulsa una nave de carga" {
		naveDeCargaVacia.propulsar()
		assert.equals(20000, naveDeCargaVacia.velocidad())
	}
	
	test "La nave de residuos toxicos recibe una amenaza" {
		naveDeResiduosToxis.recibirAmenaza()
		assert.equals(0, naveDeResiduosToxis.velocidad())
	}
	
	test "la nave con pasajeros se prepara para viaje" {
		naveConPasajeros.preparseParaViajar()
		assert.equals(300000, naveConPasajeros.velocidad())
	}
	
	test "la nave de residuos se prepara para viaje" {
		naveDeResiduosViajera.preparseParaViajar()
		assert.equals(15000, naveDeResiduosViajera.velocidad())
		assert.that(naveDeResiduosViajera.selladaAlVacio())
	}
	
	test "la nave de combate en modo reposo se prepara para viaje" {
		naveEnReposo.preparseParaViajar()
		assert.equals("Saliendo en misión", naveEnReposo.ultimoMensaje())
	}
	
	test "la nave de combate en modo ataque se prepara para viaje" {
		naveEnAtaque.preparseParaViajar()
		assert.equals("Volviendo a la base", naveEnAtaque.ultimoMensaje())
		assert.equals(15000, naveEnAtaque.velocidad())
	}
	
	test "La nave de combate en modo reposo recibe un ataque" {
		naveEnAtaque.preparseParaViajar()
		assert.equals(15000, naveEnAtaque.velocidad())
	}
	
	test "La nave de carga sin pasajeros se enfrenta a un enemigo" {
		naveConPasajerosNoVeloz.encontrarseConEnemigo()
		assert.equals(20000, naveConPasajerosNoVeloz.velocidad())
		assert.that(naveConPasajerosNoVeloz.alarma())
	}
}